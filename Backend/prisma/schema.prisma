generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       Int    @id @default(autoincrement())
  name     String
  email    String @unique
  password String
  role  String @default("listener")
}

model OTP {
  id       Int     @id @default(autoincrement())
  email    String  @unique
  name     String?
  password String?
  otp      Int
}
model Song {
  id        Int    @id @default(autoincrement())
  title     String
  audio_url String
  cover_url String
}
